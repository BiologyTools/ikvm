<!--

    openjdk.buildtools.targets
    
    Imports the OpenJDK build tools as executables into this project.

-->

<Project>
    <PropertyGroup>
        <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    </PropertyGroup>

    <Target Name="ResolveJavaToolsJar" DependsOnTargets="FindJdk" Condition=" '$(JavaToolsJarPath)' == '' And '$(JavaToolsModuleName)' == '' ">
        <PropertyGroup>
            <JavaToolsJarPath Condition="Exists('$(JdkPath)\lib\tools.jar')">$([System.IO.Path]::GetFullPath('$(JdkPath)\lib\tools.jar'))</JavaToolsJarPath>
            <JavaToolsModuleName Condition=" '$(JavaToolsJarPath)' == '' ">jdk.jdeps</JavaToolsModuleName>
        </PropertyGroup>
        <Message Text="Using tools.jar found at '$(JavaToolsJarPath)'." Importance="high" Condition=" '$(JavaToolsJarPath)' != '' " />
        <Message Text="Using JDK module '$(JavaToolsModuleName)' for OpenJDK build tools support." Importance="high" Condition=" '$(JavaToolsModuleName)' != '' " />
        <Error Text="Could not locate either tools.jar or the JDK module support needed for OpenJDK build tools." Condition=" '$(JavaToolsJarPath)' == '' And '$(JavaToolsModuleName)' == '' " />
    </Target>

    <PropertyGroup>
        <JdkBuildToolsOutputPath>$(IntermediateOutputPath)jdk_btclasses\</JdkBuildToolsOutputPath>
        <JdkBuildToolsResponseFile>$(IntermediateOutputPath)jdk_btclasses.javac.rsp</JdkBuildToolsResponseFile>
        <JdkBuildToolsStampFile>$(IntermediateOutputPath)jdk_btclasses.stamp</JdkBuildToolsStampFile>
        <JdkBuildToolsProfile Condition=" '$(JdkBuildToolsProfile)' == '' ">minimal</JdkBuildToolsProfile>
    </PropertyGroup>

    <ItemGroup Condition=" '$(JdkBuildToolsProfile)' == 'full' ">
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\src\solaris\classes\sun\awt\X11\generator\**\*.java" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jdk\src\share\classes\javax\swing\plaf\nimbus\*.template" ResourcePath="build\tools\generatenimbus\resources\%(Filename).template"/>
        <JdkBuildToolsResource Include="$(OpenJdkDir)jdk\make\data\checkdeps\refs.allowed" ResourcePath="build\tools\deps\refs.allowed"/>
    </ItemGroup>

    <ItemGroup Condition=" '$(JdkBuildToolsProfile)' != 'full' ">
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\compilefontconfig\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\customizesecurityfile\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\generatecacerts\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\generatecurrencydata\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\tzdb\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jdk\make\src\classes\build\tools\icondata\osxapp\**\*.java" />
    </ItemGroup>

    <ItemGroup Condition=" '$(JdkBuildToolsIncludeJaxb)' == 'true' ">
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\javax\xml\bind\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\bind\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\istack\internal\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\txw2\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\org\jvnet\staxex\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\fastinfoset\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\org\jvnet\fastinfoset\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaf_classes\javax\activation\**\*.java" />
        <JdkBuildToolsSource Include="$(OpenJdkDir)jaxws\src\share\jaf_classes\com\sun\activation\registries\**\*.java" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\javax\xml\bind\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\bind\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\istack\internal\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\txw2\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\org\jvnet\staxex\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\fastinfoset\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaxws_classes\com\sun\xml\internal\org\jvnet\fastinfoset\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaf_classes\javax\activation\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
        <JdkBuildToolsResource Include="$(OpenJdkDir)jaxws\src\share\jaf_classes\com\sun\activation\registries\**\*.properties" ResourcePath="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="JdkBuildToolsResponseFile" DependsOnTargets="ResolveJavaToolsJar" Inputs="$(MSBuildThisFileFullPath);@(JdkBuildToolsSource)" Outputs="$(JdkBuildToolsResponseFile)">
        <Error Text="Could not locate either tools.jar or the JDK module support needed for OpenJDK build tools." Condition=" '$(JavaToolsJarPath)' == '' And '$(JavaToolsModuleName)' == '' " />
        <Error Text="tools.jar could not be located at '$(JavaToolsJarPath)'." Condition="'$(JavaToolsJarPath)' != '' And !Exists('$(JavaToolsJarPath)')" />

        <ItemGroup>
            <_OpenJdkBuildToolsJavaCompilerClasspath Include="$(JavaToolsJarPath)" Condition=" '$(JavaToolsJarPath)' != '' " />
        </ItemGroup>

        <PropertyGroup>
            <_OpenJdkBuildToolsJavaCompilerClasspathArg>@(_OpenJdkBuildToolsJavaCompilerClasspath, '$([System.IO.Path]::PathSeparator)')</_OpenJdkBuildToolsJavaCompilerClasspathArg>
            <_OpenJdkBuildToolsJavaCompilerClasspathArg>$(_OpenJdkBuildToolsJavaCompilerClasspathArg.Replace('\', '\\'))</_OpenJdkBuildToolsJavaCompilerClasspathArg>
            <_OpenJdkBuildToolsJavaCompilerSourceVersion Condition=" '$(JavaToolsModuleName)' != '' ">11</_OpenJdkBuildToolsJavaCompilerSourceVersion>
            <_OpenJdkBuildToolsJavaCompilerSourceVersion Condition=" '$(_OpenJdkBuildToolsJavaCompilerSourceVersion)' == '' ">1.8</_OpenJdkBuildToolsJavaCompilerSourceVersion>
            <_OpenJdkBuildToolsJavaCompilerTargetVersion Condition=" '$(JavaToolsModuleName)' != '' ">11</_OpenJdkBuildToolsJavaCompilerTargetVersion>
            <_OpenJdkBuildToolsJavaCompilerTargetVersion Condition=" '$(_OpenJdkBuildToolsJavaCompilerTargetVersion)' == '' ">1.8</_OpenJdkBuildToolsJavaCompilerTargetVersion>
        </PropertyGroup>

        <ItemGroup>
            <_OpenJdkBuildToolsJavaCompilerArgs Include="--add-modules" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="$(JavaToolsModuleName)" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="--add-exports" Condition=" '$(JavaToolsModuleName)' == 'jdk.jdeps' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="jdk.jdeps/com.sun.tools.classfile=ALL-UNNAMED" Condition=" '$(JavaToolsModuleName)' == 'jdk.jdeps' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="--add-exports" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="java.desktop/sun.awt=ALL-UNNAMED" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="--add-exports" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="java.base/sun.text=ALL-UNNAMED" Condition=" '$(JavaToolsModuleName)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="-cp" Condition=" '$(_OpenJdkBuildToolsJavaCompilerClasspathArg)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="&quot;$([MSBuild]::Escape('$(_OpenJdkBuildToolsJavaCompilerClasspathArg)'))&quot;" Condition=" '$(_OpenJdkBuildToolsJavaCompilerClasspathArg)' != '' " />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="-source" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="$(_OpenJdkBuildToolsJavaCompilerSourceVersion)" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="-target" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="$(_OpenJdkBuildToolsJavaCompilerTargetVersion)" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="-nowarn" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="-d" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="$(JdkBuildToolsOutputPath)" />
            <_OpenJdkBuildToolsJavaCompilerArgs Include="@(JdkBuildToolsSource->'%(FullPath)')" />
        </ItemGroup>
        <WriteLinesToFile File="$(JdkBuildToolsResponseFile)" Lines="@(_OpenJdkBuildToolsJavaCompilerArgs)" Overwrite="true" WriteOnlyWhenDifferent="true" />

        <ItemGroup>
            <FileWrites Include="$(JdkBuildToolsResponseFile)" />
        </ItemGroup>
    </Target>

    <Target Name="BuildJdkBuildTools" DependsOnTargets="ResolveJavaCompiler;JdkBuildToolsResponseFile" Inputs="$(JdkBuildToolsResponseFile);@(JdkBuildToolsSource);@(JdkBuildToolsResource)" Outputs="$(JdkBuildToolsStampFile);@(JdkBuildToolsResource->'$(JdkBuildToolsOutputPath)%(ResourcePath)')">
        <Error Text="Could not locate javac executable." Condition=" '$(JavaCompilerPath)' == '' " />
        <Error Text="javac could not be located at '$(JavaCompilerPath)'." Condition="!Exists('$(JavaCompilerPath)')" />
        <Exec Command="chmod +x $(JavaCompilerPath) >/dev/null 2>&amp;1" IgnoreExitCode="true" IgnoreStandardErrorWarningFormat="true" StandardErrorImportance="low" ContinueOnError="true" Condition="$([MSBuild]::IsOSUnixLike())" />

        <Delete Files="$(JdkBuildToolsStampFile)" />
        <MakeDir Directories="$(JdkBuildToolsOutputPath)" />
        <Message Text="$(JavaCompilerExec) @$(JdkBuildToolsResponseFile)" />
        <Exec Command="$(JavaCompilerExec) @$(JdkBuildToolsResponseFile)" />
        <Copy SourceFiles="@(JdkBuildToolsResource)" DestinationFiles="@(JdkBuildToolsResource->'$(JdkBuildToolsOutputPath)%(ResourcePath)')" />
        <Touch Files="@(JdkBuildToolsResource->'$(JdkBuildToolsOutputPath)%(ResourcePath)')" ForceTouch="true" />
        <Touch Files="$(JdkBuildToolsStampFile)" AlwaysCreate="true" ForceTouch="true" />

        <ItemGroup>
            <OpenJdkBuildToolsClassFiles Include="$(JdkBuildToolsOutputPath)**\*.class" />
            <FileWrites Include="$(JdkBuildToolsStampFile)" />
            <FileWrites Include="$(JdkBuildToolsOutputPath)**\*.class" />
            <FileWrites Include="@(JdkBuildToolsResource->'$(JdkBuildToolsOutputPath)%(ResourcePath)')" />
        </ItemGroup>
    </Target>

</Project>
