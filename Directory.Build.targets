<Project>
    <Import Project="targets\ClangProjectReference.targets" />
    <Import Project="targets\DotNetOSXCodeSign.targets"/>

    <PropertyGroup>
        <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == 'win7-x86' ">win-x86</RuntimeIdentifier>
        <RuntimeIdentifier Condition=" '$(RuntimeIdentifier)' == 'win7-x64' ">win-x64</RuntimeIdentifier>
        <Prefer32Bit Condition=" '$(RuntimeIdentifier)' == 'win-x86' And $([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net461'))">true</Prefer32Bit>
        <IkvmDepsFileExtensionsRetryDelayMilliseconds Condition=" '$(IkvmDepsFileExtensionsRetryDelayMilliseconds)' == '' ">500</IkvmDepsFileExtensionsRetryDelayMilliseconds>
        <GetBuildProjectPathDependsOn>
            $(GetBuildProjectPathDependsOn);
            GetTargetPath;
        </GetBuildProjectPathDependsOn>
    </PropertyGroup>

    <!-- IKVM.Core.MSBuild 0.1.106 selects TaskHostFactory even when running under
         dotnet MSBuild. Run its netstandard2.0 tasks in-process on Core MSBuild so
         builds do not require an MSBuild.exe task host from the .NET SDK folder. -->
    <UsingTask TaskName="GenerateDepsFileExtensions" AssemblyFile="$(IkvmCoreMSBuildTaskAssembly)" Override="true" Condition=" '$(MSBuildRuntimeType)' == 'Core' And Exists('$(IkvmCoreMSBuildTaskAssembly)') " />
    <UsingTask TaskName="ResolveNearestRuntimeIdentifier" AssemblyFile="$(IkvmCoreMSBuildTaskAssembly)" Override="true" Condition=" '$(MSBuildRuntimeType)' == 'Core' And Exists('$(IkvmCoreMSBuildTaskAssembly)') " />

    <Target Name="GetBuildProjectPath" DependsOnTargets="$(GetBuildProjectPathDependsOn)" Returns="$(GetBuildProjectPath)">
        <PropertyGroup>
            <GetBuildProjectPath>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</GetBuildProjectPath>
        </PropertyGroup>
    </Target>

    <Target Name="GenerateBuildDependencyFileExtensions" AfterTargets="GenerateBuildDependencyFile" Condition=" '$(GenerateDependencyFile)' == 'true' And '$(ProjectDepsFilePath)' != '' ">
        <GenerateDepsFileExtensions DepsFilePath="$(ProjectDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" ContinueOnError="WarnAndContinue" />
        <Message Text="Retrying GenerateDepsFileExtensions for $(ProjectDepsFilePath)." Importance="high" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Sleep Duration="$(IkvmDepsFileExtensionsRetryDelayMilliseconds)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <GenerateDepsFileExtensions DepsFilePath="$(ProjectDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" ContinueOnError="WarnAndContinue" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Message Text="Retrying GenerateDepsFileExtensions for $(ProjectDepsFilePath)." Importance="high" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Sleep Duration="$(IkvmDepsFileExtensionsRetryDelayMilliseconds)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <GenerateDepsFileExtensions DepsFilePath="$(ProjectDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
    </Target>

    <Target Name="GeneratePublishDependencyFileExtensions" AfterTargets="GeneratePublishDependencyFile" BeforeTargets="ComputeFilesToPublish" Condition=" '$(GenerateDependencyFile)' == 'true' And '$(IntermediateDepsFilePath)' != '' ">
        <GenerateDepsFileExtensions DepsFilePath="$(IntermediateDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" ContinueOnError="WarnAndContinue" />
        <Message Text="Retrying GenerateDepsFileExtensions for $(IntermediateDepsFilePath)." Importance="high" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Sleep Duration="$(IkvmDepsFileExtensionsRetryDelayMilliseconds)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <GenerateDepsFileExtensions DepsFilePath="$(IntermediateDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" ContinueOnError="WarnAndContinue" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Message Text="Retrying GenerateDepsFileExtensions for $(IntermediateDepsFilePath)." Importance="high" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <Sleep Duration="$(IkvmDepsFileExtensionsRetryDelayMilliseconds)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
        <GenerateDepsFileExtensions DepsFilePath="$(IntermediateDepsFilePath)" AdditionalRuntimeLibraryAssets="@(AdditionalRuntimeLibraryAssets)" AdditionalRuntimeNativeAssets="@(AdditionalRuntimeNativeAssets)" Condition=" '$(MSBuildLastTaskResult)' != 'true' " />
    </Target>
    
</Project>
